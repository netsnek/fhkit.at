  "devDependencies": {
    "@chakra-ui/cli": "^3.36.1",
    "@types/github-slugger": "^2.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.3.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@types/react-highlight-words": "^0.16.4",
    "typescript": "^5.1.6"
