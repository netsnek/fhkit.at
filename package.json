{
  "name": "fhkit.at",
  "description": "fhkit.at, built with Gatsby and Jaen",
  "version": "1.0.0",
  "private": true,
  "author": "Florian Kleber",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "NODE_OPTIONS=--max-old-space-size=8192 gatsby develop -H 0.0.0.0",
    "start": "yarn develop",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "postinstall": "yarn typegen",
    "typegen": "chakra typegen src/styles/theme/system.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.11.1",
    "@reach/router": "^1.3.4",
    "@react-icons/all-files": "https://github.com/react-icons/react-icons/releases/download/v4.11.0/react-icons-all-files-4.11.0.tgz",
    "@sindresorhus/slugify": "^2.2.1",
    "flexsearch": "^0.7.43",
    "framer-motion": "^10.16.1",
    "gatsby": "^5.11.0",
    "gatsby-jaen-emailwerk": "link:../jaen/packages/gatsby-jaen-emailwerk",
    "gatsby-plugin-cloudflare-pages": "^1.0.3",
    "gatsby-plugin-jaen": "link:../jaen/packages/gatsby-plugin-jaen",
    "gatsby-source-jaen": "link:../jaen/packages/gatsby-source-jaen",
    "github-slugger": "^2.0.0",
    "jaen": "link:../jaen/packages/jaen",
    "jaen-fields-mdx": "link:../jaen/packages/jaen-fields-mdx",
    "next-themes": "^0.4.6",
    "oidc-client-ts": "^2.4.0",
    "prismjs": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-fast-marquee": "^1.6.4",
    "react-highlight-words": "^0.20.0",
    "react-hook-form": "^7.51.5",
    "react-intl": "6.8.9",
    "react-simple-code-editor": "^0.13.1",
    "snek-query": "^0.0.114",
    "use-debounce": "^10.0.0"
  },
  "resolutions": {
    "msgpackr": "^1.10.2",
    "ordered-binary": "^1.5.3",
    "graphql": "link:../jaen/node_modules/graphql",
    "jaen": "link:../jaen/packages/jaen",
    "gatsby-plugin-jaen": "link:../jaen/packages/gatsby-plugin-jaen",
    "gatsby-source-jaen": "link:../jaen/packages/gatsby-source-jaen",
    "gatsby-jaen-emailwerk": "link:../jaen/packages/gatsby-jaen-emailwerk",
    "jaen-fields-mdx": "link:../jaen/packages/jaen-fields-mdx"
